{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuantForge snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "snapshot_id",
    "as_of",
    "created_at",
    "source_ids",
    "quotes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "timezone": {
      "type": "string"
    },
    "cutoff": {
      "type": "string",
      "pattern": "^[0-2][0-9]:[0-5][0-9]$"
    },
    "quotes": {
      "type": "array",
      "items": {
        "$ref": "quote.schema.json"
      }
    },
    "trades": {
      "type": "array",
      "items": {
        "$ref": "trade.schema.json"
      }
    },
    "curves": {
      "type": "array",
      "items": {
        "$ref": "curve.schema.json"
      }
    },
    "fixings": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
