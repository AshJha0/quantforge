{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuantForge result",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ok",
        "error"
      ]
    },
    "outputs": {
      "type": "object"
    },
    "diagnostics": {
      "type": "object"
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^E_[A-Z_]+$"
        },
        "message": {
          "type": "string"
        },
        "field": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "description": "Calculation provenance from architecture/data-contracts.md",
      "required": [
        "calculation_id",
        "input_snapshot_id",
        "model_name",
        "model_version",
        "configuration_hash",
        "calculation_time",
        "result_status"
      ],
      "properties": {
        "calculation_id": {
          "type": "string",
          "minLength": 1
        },
        "input_snapshot_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "model_name": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "configuration_hash": {
          "type": "string",
          "minLength": 1
        },
        "calculation_time": {
          "type": "string",
          "format": "date-time"
        },
        "result_status": {
          "type": "string",
          "minLength": 1
        },
        "diagnostics": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "status": {
          "const": "ok"
        }
      },
      "required": [
        "outputs"
      ],
      "not": {
        "required": [
          "error"
        ]
      }
    },
    {
      "properties": {
        "status": {
          "const": "error"
        }
      },
      "required": [
        "error"
      ],
      "not": {
        "required": [
          "outputs"
        ]
      }
    }
  ]
}
