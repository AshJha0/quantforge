{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuantForge conformance case",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "operation",
    "inputs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"
    },
    "inputs": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
