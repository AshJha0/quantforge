{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuantForge curve",
  "type": "object",
  "required": [
    "schema_version",
    "curve_id",
    "curve_type",
    "as_of",
    "currency",
    "day_count",
    "interpolation",
    "pillars",
    "snapshot_id"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "curve_id": {
      "type": "string",
      "minLength": 1
    },
    "curve_type": {
      "enum": [
        "DISCOUNT",
        "ZERO",
        "FORWARD",
        "SPREAD",
        "HAZARD",
        "INFLATION",
        "DIVIDEND",
        "VOLATILITY"
      ]
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "day_count": {
      "type": "string",
      "minLength": 1
    },
    "compounding": {
      "type": "object"
    },
    "interpolation": {
      "type": "string",
      "minLength": 1
    },
    "extrapolation": {
      "type": "string"
    },
    "pillars": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "date",
          "value",
          "unit"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "source_instrument_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "model_version": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
