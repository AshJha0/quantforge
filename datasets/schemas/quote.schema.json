{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuantForge Quote",
  "type": "object",
  "required": [
    "schema_version",
    "instrument_id",
    "event_time",
    "currency",
    "bid",
    "ask",
    "quality_flags",
    "quote_status",
    "unit",
    "snapshot_id"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "instrument_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string"
    },
    "event_time": {
      "type": "string",
      "format": "date-time"
    },
    "receive_time": {
      "type": "string",
      "format": "date-time"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "bid": {
      "type": [
        "number",
        "null"
      ]
    },
    "ask": {
      "type": [
        "number",
        "null"
      ]
    },
    "bid_size": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "ask_size": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "quality_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "MISSING_BID",
          "MISSING_ASK",
          "CROSSED",
          "LOCKED",
          "STALE",
          "WIDE_SPREAD",
          "NON_POSITIVE",
          "OUTLIER"
        ]
      }
    },
    "quote_status": {
      "enum": [
        "FIRM",
        "INDICATIVE",
        "STALE",
        "CROSSED",
        "MISSING"
      ],
      "description": "See specifications/01-core/data-checks.md"
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "description": "sha256: id of the snapshot holding this quote; see specifications/01-core/snapshot-hash.md"
    },
    "timezone": {
      "type": "string"
    },
    "market_timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}