{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuantForge market trade",
  "type": "object",
  "required": [
    "schema_version",
    "instrument_id",
    "event_time",
    "currency",
    "unit",
    "trade_id",
    "price",
    "quantity",
    "trade_timestamp",
    "venue",
    "quality_flags",
    "snapshot_id"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "instrument_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string"
    },
    "event_time": {
      "type": "string",
      "format": "date-time"
    },
    "receive_time": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "quality_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trade_id": {
      "type": "string",
      "minLength": 1
    },
    "price": {
      "type": "number"
    },
    "quantity": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "aggressor_side": {
      "enum": [
        "BUY",
        "SELL",
        null
      ]
    },
    "venue": {
      "type": "string",
      "minLength": 1
    },
    "trade_timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
